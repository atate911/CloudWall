# systemd user unit. Install with `make service`, which fills in @DIR@.
[Unit]
Description=CloudWall flight board
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/cloudwall
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
